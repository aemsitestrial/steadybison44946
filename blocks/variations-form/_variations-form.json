{
  "definitions": [
    {
      "title": "Variations Form",
      "id": "variations-form",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 1,
          "fields": [
            {
              "name": "classes",
              "selector": "div:nth-child(1)>div>ul"
            }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Variations Form",
              "model": "variations-form"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "variations-form",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "formTitle",
          "label": "Form Title / Heading"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "formDescription",
          "label": "Form Description"
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Theme & Style",
          "valueType": "string",
          "options": [
            { "name": "Dark Theme", "value": "dark" },
            { "name": "Light Theme", "value": "light" }
          ]
        }
      ]
    },
    {
      "id": "field-text",
      "fields": [
        { "component": "text", "name": "name", "label": "Field Name / ID", "required": true },
        { "component": "text", "name": "label", "label": "Field Label", "required": true },
        {
          "component": "select",
          "name": "type",
          "label": "Input Type",
          "value": "text",
          "options": [
            { "name": "Text", "value": "text" },
            { "name": "Email", "value": "email" },
            { "name": "Tel", "value": "tel" }
          ]
        },
        { "component": "checkbox", "name": "required", "label": "Mandatory Field (*)" },
        { "component": "text", "name": "dependsOn", "label": "Show Only If Parent Dropdown Value Equals" }
      ]
    },
    {
      "id": "field-select",
      "fields": [
        { "component": "text", "name": "name", "label": "Dropdown ID", "required": true },
        { "component": "text", "name": "label", "label": "Dropdown Label", "required": true },
        { "component": "checkbox", "name": "required", "label": "Mandatory Field (*)" },
        { "component": "text", "name": "options", "label": "Options (Comma Separated e.g. Asia Pacific, India, USA)" },
        { "component": "text", "name": "dependsOn", "label": "Show Only If Parent Dropdown Value Equals" }
      ]
    },
    {
      "id": "field-textarea",
      "fields": [
        { "component": "text", "name": "name", "label": "Field ID", "required": true },
        { "component": "text", "name": "label", "label": "Field Label", "required": true },
        { "component": "number", "name": "maxLength", "label": "Max Character Limit", "value": 1500 },
        { "component": "checkbox", "name": "required", "label": "Mandatory Field (*)" },
        { "component": "text", "name": "dependsOn", "label": "Show Only If Parent Dropdown Value Equals" }
      ]
    },
    {
      "id": "field-checkbox",
      "fields": [
        { "component": "text", "name": "name", "label": "Checkbox ID", "required": true },
        { "component": "richtext", "name": "label", "label": "Consent Label / Disclaimer Text", "required": true },
        { "component": "checkbox", "name": "required", "label": "Mandatory Field (*)" },
        { "component": "text", "name": "dependsOn", "label": "Show Only If Parent Dropdown Value Equals" }
      ]
    },
    {
      "id": "contact-card",
      "fields": [
        { "component": "text", "name": "region", "label": "Target Region Match (e.g., India)", "required": true },
        { "component": "text", "name": "contactName", "label": "Contact Person Name", "required": true },
        { "component": "text", "name": "emails", "label": "Emails (Comma Separated)" },
        { "component": "text", "name": "phones", "label": "Phone Numbers (Comma Separated)" }
      ]
    },
    {
      "id": "field-submit",
      "fields": [
        { "component": "text", "name": "label", "label": "Button Label", "value": "Send" },
        { "component": "text", "name": "dependsOn", "label": "Show Only If Parent Dropdown Value Equals" }
      ]
    }
  ],
  "filters": [
    {
      "id": "variations-form",
      "components": [
        "field-text",
        "field-select",
        "field-textarea",
        "field-checkbox",
        "contact-card",
        "field-submit"
      ]
    }
  ]
}