{
  "definitions": [
    {
      "title": "Card",
      "id": "card",
      "plugins": {
        "da": {
          "rows": 8,
          "columns": 1,
          "fields": [
            {
              "name": "fileReference",
              "selector": "div:nth-child(1)>div>picture>img[src]"
            },
            {
              "name": "fileReferenceAlt",
              "selector": "div:nth-child(1)>div>picture>img[alt]"
            },
            {
              "name": "classes",
              "selector": "div:nth-child(1)>div>ul"
            },
            {
              "name": "tag",
              "selector": "div:nth-child(2)>div"
            },
            {
              "name": "eyebrow",
              "selector": "div:nth-child(3)>div"
            },
            {
              "name": "title",
              "selector": "div:nth-child(4)>div"
            },
            {
              "name": "titleType",
              "selector": "div:nth-child(4)>div>:first-child"
            },
            {
              "name": "description",
              "selector": "div:nth-child(5)>div"
            },
            {
              "name": "link",
              "selector": "div:nth-child(6)>div>p>a[href]"
            },
            {
              "name": "linkText",
              "selector": "div:nth-child(6)>div>p>a"
            },
            {
              "name": "linkType",
              "selector": "div:nth-child(6)>div>p>:first-child"
            }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Card",
              "model": "card",
              "tag": "TAG",
              "eyebrow": "",
              "title": "The intelligent enterprise",
              "titleType": "h2",
              "description": "How AI is transforming decisions, operations and the nature of work",
              "link": "",
              "linkText": "",
              "linkType": "primary",
              "classes": ["dark", "tcs-background-dark-navy"]
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "fileReference",
          "label": "Background Image"
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "fileReferenceAlt",
          "label": "Image Alt Text"
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "classes",
          "label": "Style & Background Color",
          "options": [
            {
              "name": "Theme",
              "children": [
                { "name": "Dark / White Text", "value": "dark" },
                { "name": "Light / Dark Text", "value": "light" }
              ]
            },
            {
              "name": "Background Color",
              "children": [
                { "name": "Dark Navy", "value": "tcs-background-dark-navy" },
                { "name": "Blue", "value": "tcs-background-blue" },
                { "name": "Red", "value": "tcs-background-red" },
                { "name": "Yellow", "value": "tcs-background-yellow" },
                { "name": "Beige", "value": "tcs-background-beige" },
                { "name": "Black", "value": "tcs-background-black" }
              ]
            }
          ]
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "tag",
          "label": "Tag Badge Text"
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "title",
          "label": "Card Heading"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "titleType",
          "label": "Heading Type",
          "options": [
            { "name": "H1", "value": "h1" },
            { "name": "H2", "value": "h2" },
            { "name": "H3", "value": "h3" },
            { "name": "H4", "value": "h4" }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "link",
          "label": "CTA Link URL"
        },
        {
          "component": "text-input",
          "valueType": "string",
          "name": "linkText",
          "label": "CTA Button Text"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "linkType",
          "label": "CTA Button Style",
          "options": [
            { "name": "Primary", "value": "primary" },
            { "name": "Secondary", "value": "secondary" }
          ]
        }
      ]
    }
  ],
  "filters": []
}