          "value": "",
          "label": "Link Text"
        },
        {
          "component": "select",
          "name": "linkType",
          "value": "primary",
          "label": "Link Type",
          "valueType": "string",
          "options": [
            { "name": "Primary Button", "value": "primary" },
            { "name": "Secondary Button", "value": "secondary" },
            { "name": "Text Link", "value": "link" }
