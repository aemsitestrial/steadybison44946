        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkText",
          "value": "",
          "label": "CTA Text"
        },
        {
          "component": "select",
          "name": "linkType",
          "value": "primary",
          "label": "CTA Style",
          "valueType": "string",
          "options": [
            { "name": "Primary Button", "value": "primary" },
            { "name": "Secondary Button", "value": "secondary" },
            { "name": "Text Link", "value": "link" }
          ]
        }
      ]
    }
  ],
  "filters": []
