{
  "definitions": [
    {
      "title": "Card",
      "id": "card",
      "plugins": {
        "da": {
          "rows": 7,
          "columns": 1,
          "fields": [
            {
              "name": "fileReference",
              "selector": "div:nth-child(1)>div>picture>img[src]"
            },
            {
              "name": "fileReferenceAlt",
              "selector": "div:nth-child(1)>div>picture>img[alt]"
            },
            {
              "name": "classes",
              "selector": "div:nth-child(1)>div>ul"
            },
            {
              "name": "eyebrow",
              "selector": "div:nth-child(2)>div"
            },
            {
              "name": "title",
              "selector": "div:nth-child(3)>div"
            },
            {
              "name": "titleType",
              "selector": "div:nth-child(3)>div>:first-child"
            },
            {
              "name": "description",
              "selector": "div:nth-child(4)>div"
            },
            {
              "name": "link",
              "selector": "div:nth-child(5)>div>p>a[href]"
            },
            {
              "name": "linkText",
              "selector": "div:nth-child(5)>div>p>a"
            },
            {
              "name": "linkType",
              "selector": "div:nth-child(5)>div>p>:first-child"
            }
          ]
        },
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Card",
              "model": "card",
              "title": "Human + Machine",
              "titleType": "h2",
              "description": "",
              "classes": ["light"]
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "fileReference",
          "label": "Image",
